module lab3_1(
    input wire clk,
    input wire rst,
    output wire tx,
    input wire rx,
    input wire pin_88,
    input wire pin_24,
    input wire pin_25
);

wire txclk_en, rxclk_en;
wire [7:0] rx_data;
wire rx_rdy;

reg [7:0] tx_byte;
reg tx_send;

wire [2:0] buttons = {~pin_88, ~pin_24, ~pin_25};

baud_rate_gen uart_baud(.clk_50m(clk), .rxclk_en(rxclk_en), .txclk_en(txclk_en));
transmitter uart_tx(.din(tx_byte), .wr_en(tx_send), .clk_50m(clk), .clken(txclk_en), .tx(tx));
receiver uart_rx(.rx(rx), .rdy(rx_rdy), .rdy_clr(rx_rdy), .clk_50m(clk), .clken(rxclk_en), .data(rx_data));

always @(posedge clk or negedge rst) begin
    if(!rst) begin
        tx_send <= 0;
        tx_byte <= 0;
    end else begin
        tx_send <= 0;

        if (rx_rdy && (rx_data == 8'h20)) 
            tx_byte <= 8'h30 + {5'b00000, buttons}; 
            tx_send <= 1;
        end
    end
end

endmodule
